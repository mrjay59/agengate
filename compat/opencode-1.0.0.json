{
  "schema_version": 1,
  "updated": "2026-11-09",
  "client": "opencode",
  "binary": "opencode",
  "transport": "stdio_shim",
  "mcp_config_method": "env_var",
  "env_var_name": "OPENCODE_CONFIG_CONTENT",
  "strict_mcp_config": false,
  "disable_builtins": "excludeTools: [\"*\"] in injected config",
  "reasoning_effort": {
    "mapping": {
      "low": { "reasoning_effort": "low" },
      "medium": { "reasoning_effort": "medium" },
      "high": { "reasoning_effort": "high" }
    },
    "passthrough": true,
    "notes": "OpenCode accepts native reasoning_effort param"
  },
  "tool_calls": {
    "sse_format": "2-chunk (§7.4)",
    "supports_parallel": true,
    "via_bridge": true
  },
  "streaming_reasoning": {
    "supported": true,
    "format": "thinking_blocks_in_ndjson",
    "notes": "Native thinking blocks in NDJSON stream"
  },
  "session_persistence": {
    "supported": true,
    "method": "parked_process_resume",
    "notes": "Replay fallback if parked process lost (§10.6)"
  },
  "windows": {
    "cmd_wrapper": "opencode.cmd",
    "process_tree_kill": "taskkill /F /T /PID",
    "path_ext": true
  },
  "temp_dir": "temp_dir()/agentgate/sessions/{id}/",
  "verification_status": "P1a complete — E2E 9router/AionUI pending"
}